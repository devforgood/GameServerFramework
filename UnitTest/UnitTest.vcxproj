  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <!--
    vcpkg 배포 단계가 behaviortree_cppd.dll 을 출력 폴더에 넣지 않는다(릴리스 dll 만 넣는다).
    그러면 빌드는 성공하는데 UnitTest.exe 가 아무 출력 없이 STATUS_DLL_NOT_FOUND(-1073741515)
    로 즉사한다 — 원인이 로그에 전혀 남지 않아 매번 헤맸다.

    PostBuildEvent 가 아니라 별도 타깃인 이유: 후처리 이벤트는 링크가 실제로 일어날 때만
    돈다. 소스가 그대로면 건너뛰는데, 그 사이 배포 단계가 dll 을 지워 놓으면 "빌드는 성공,
    실행은 즉사" 상태로 남는다. Inputs/Outputs 를 두지 않아 매 빌드 반드시 확인한다.
  -->
  <Target Name="CopyBehaviorTreeDebugDll" AfterTargets="Build">
    <Copy SourceFiles="$(ProjectDir)..\x64\$(Configuration)\behaviortree_cppd.dll"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(ProjectDir)..\x64\$(Configuration)\behaviortree_cppd.dll')" />
  </Target>
