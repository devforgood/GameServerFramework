{% for table in tables %}
CREATE TABLE {{ table.name }}
(
{% for col in table.columns %}
    {{ "%-20s" | format(col.name) }} {{ "%-15s" | format(col.type) }}{% if not col.nullable %} NOT NULL{% endif %}{% if col.default is not none %} DEFAULT {{ col.default }}{% endif %}{% if col.auto_increment %} AUTO_INCREMENT{% endif %},
{% endfor %}

{% if table.primary_key %}
    PRIMARY KEY ({{ table.primary_key }}){% if table.unique_keys or table.indices %},{% endif %}
{% endif %}

{% for uk in table.unique_keys %}
    UNIQUE KEY ({{ uk }}){% if not loop.last or table.indices %},{% endif %}
{% endfor %}

{% for idx in table.indices %}
    INDEX ({{ idx }}){% if not loop.last %},{% endif %}
{% endfor %}
);

{% endfor %}
