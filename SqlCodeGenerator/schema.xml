<database>
  <table name="player" class_name="PlayerDAO" file_name="dao">
    <column name="id" type="BIGINT" auto_increment="true" nullable="false"/>
    <column name="name" type="VARCHAR(50)" nullable="false"/>
    <column name="level" type="INT" default="1"/>
    <primary_key>id</primary_key>
    <unique_key>name</unique_key>
  </table>
  <table name="item" class_name="ItemDAO" file_name="dao">
    <column name="id" type="BIGINT" auto_increment="true" nullable="false"/>
    <column name="player_id" type="BIGINT" nullable="false" />
    <column name="level" type="INT" default="1"/>
    <primary_key>id</primary_key>
    <index>player_id</index>
  </table>
  <table name="skill" class_name="SkillDAO" file_name="dao">
    <column name="id" type="BIGINT" auto_increment="true" nullable="false"/>
    <column name="player_id" type="BIGINT" nullable="false" />
    <column name="skill_id" type="BIGINT" nullable="false" />
    <column name="level" type="INT" default="1"/>
    <primary_key>id</primary_key>
    <unique_key>player_id, skill_id</unique_key>
    <index>player_id</index>
  </table>
  <table name="quest" class_name="QuestDAO" file_name="dao">
    <column name="id" type="BIGINT" auto_increment="true" nullable="false"/>
    <column name="player_id" type="BIGINT" nullable="false" />
    <column name="quest_id" type="BIGINT" nullable="false" />
    <column name="state" type="INT" default="0"/>
    <column name="objective_count" type="INT" default="0"/>
    <primary_key>id</primary_key>
    <unique_key>player_id, quest_id</unique_key>
    <index>player_id</index>
  </table>
</database>
