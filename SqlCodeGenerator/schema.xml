<database>
  <table name="player" class_name="PlayerDAO" file_name="dao">
    <column name="id" type="BIGINT" auto_increment="true" nullable="false"/>
    <column name="name" type="VARCHAR(50)" nullable="false"/>
    <column name="level" type="INT" default="1"/>
    <primary_key>id</primary_key>
    <unique_key>name</unique_key>
  </table>
  <!--
    인벤토리/보유 스킬은 (캐릭터, 종류) 한 쌍이 곧 한 줄이다. 자동 증가 id 를 쓰면
    INSERT 한 뒤 그 id 를 알 수 없어서 다음 저장의 UPDATE 가 갈 곳을 잃는다
    (quest_active 와 같은 복합 키 방식으로 맞췄다).
    이전의 item/skill 테이블과는 이름이 달라 기존 DB 에 그대로 두어도 충돌하지 않는다.
  -->
  <table name="player_item" class_name="PlayerItemDAO" file_name="dao">
    <column name="character_id" type="BIGINT" nullable="false"/>
    <column name="item_id" type="INT" nullable="false"/>
    <column name="count" type="INT" default="0" nullable="false"/>
    <primary_key>character_id, item_id</primary_key>
    <index>character_id</index>
  </table>
  <table name="player_skill" class_name="PlayerSkillDAO" file_name="dao">
    <column name="character_id" type="BIGINT" nullable="false"/>
    <column name="skill_id" type="INT" nullable="false"/>
    <column name="level" type="INT" default="1" nullable="false"/>
    <primary_key>character_id, skill_id</primary_key>
    <index>character_id</index>
  </table>
  <!-- 재화는 player 테이블에 붙이지 않는다. PlayerLevel 이 PlayerVO 전체를 다시 만들어
       저장하기 때문에, 같은 행을 두 컴포넌트가 쓰면 서로를 덮어쓴다. -->
  <table name="player_wallet" class_name="PlayerWalletDAO" file_name="dao">
    <column name="character_id" type="BIGINT" nullable="false"/>
    <column name="gold" type="BIGINT" default="0" nullable="false"/>
    <primary_key>character_id</primary_key>
  </table>
  <table name="quest_active" class_name="QuestActiveDAO" file_name="dao">
    <column name="character_id" type="BIGINT" nullable="false"/>
    <column name="quest_id" type="INT" nullable="false"/>
    <column name="state" type="TINYINT" nullable="false"/>
    <column name="stage" type="TINYINT" default="1" nullable="false"/>
    <column name="progress1" type="INT" default="0" nullable="false"/>
    <column name="progress2" type="INT" default="0" nullable="false"/>
    <column name="progress3" type="INT" default="0" nullable="false"/>
    <column name="accept_time" type="DATETIME" nullable="false"/>
    <primary_key>character_id, quest_id</primary_key>
    <index>character_id</index>
  </table>
  <table name="quest_state" class_name="QuestStateDAO" file_name="dao">
    <column name="character_id" type="BIGINT" nullable="false"/>
    <column name="flags" type="BLOB" nullable="false"/>
    <primary_key>character_id</primary_key>
  </table>
</database>
