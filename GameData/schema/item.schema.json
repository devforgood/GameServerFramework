{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ItemList",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "integer",
        "minimum": 1,
        "description": "고유 숫자 ID"
      },
      "type": {
        "type": "string",
        "enum": [ "consumable", "equipment", "material" ],
        "description": "아이템 종류"
      },
      "heal": {
        "type": "number",
        "minimum": 0,
        "description": "회복량"
      },
      "name_id": {
        "type": "string",
        "description": "다국어 키 (이름)"
      },
      "desc_id": {
        "type": "string",
        "description": "다국어 키 (설명)"
      }
    },
    "required": [ "id", "type", "name_id", "desc_id" ],
    "additionalProperties": false
  }
}