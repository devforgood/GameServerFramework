<Project>
  <!--
    vcpkg applocal DLL 배포를 PowerShell(pwsh.exe) 대신 vcpkg.exe의 내장 z-applocal로 수행한다.
    이 머신에는 pwsh.exe가 없는데, vcpkg.targets의 pwsh 경로는 UseCommandProcessor=false라
    pwsh 부재 시 종료코드 9009가 나오지 않아 system powershell 폴백(== 9009 조건)이 트리거되지 않는다.
    그 결과 디버그 빌드 폴더에 릴리스 abseil_dll.dll 등이 stale로 남아 libprotobufd.dll과 ABI가
    어긋나 protobuf 정적 초기화 중 크래시가 발생했다. 내장 경로는 PowerShell에 의존하지 않으므로
    구성에 맞는 (debug/release) DLL을 항상 정확히 배포한다.
  -->
  <PropertyGroup>
    <VcpkgXUseBuiltInApplocalDeps>true</VcpkgXUseBuiltInApplocalDeps>
  </PropertyGroup>

  <!--
    소스를 항상 UTF-8로 해석한다. BOM 없는 UTF-8 파일을 시스템 코드페이지(CP949)로
    읽으면 한글 주석 끝 글자의 마지막 바이트가 2바이트 선행 바이트로 오인되어 개행을
    삼키고, 다음 줄이 주석에 빨려 들어가 사라지는 MSVC 버그가 발생한다.
  -->
  <!--
    Windows SDK 타깃 버전. Boost.Asio 는 이 값이 없으면 경고를 내고 **조용히
    _WIN32_WINNT=0x0601(Windows 7)로 정의해 버린다**(boost/asio/detail/config.hpp).

    예전에는 Engine/Server.h 안에서만 0x0A00 으로 정의했는데, 그 방식은 Server.h 가
    boost 보다 먼저 include 된 TU 에서만 먹는다. 그래서 같은 Engine.lib 안에 0x0A00 로
    컴파일된 TU 와 0x0601 로 컴파일된 TU 가 섞였다 — Windows SDK 헤더가 버전에 따라
    구조체와 선언을 바꾸므로, 링크는 되지만 서로 다른 정의를 하나로 묶는 상태가 된다.

    컴파일러 명령줄에 두면 어떤 헤더보다 먼저 서므로 TU 마다 갈릴 수 없다.
    프로젝트별로 두면 새 프로젝트에서 빠뜨리기 쉬워 여기서 일괄 적용한다.
  -->
  <!--
    cl.exe는 기본적으로 한 프로젝트의 .cpp를 순차 컴파일한다. Engine은 71개 TU를 가지고
    있어 16코어 머신에서도 전체 리빌드가 284초 걸렸다. /MP를 켜면 37.9초로 줄어든다.
    프로젝트별로 두면 새 프로젝트에서 빠뜨리기 쉬워 여기서 일괄 적용한다.
  -->
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <PreprocessorDefinitions>_WIN32_WINNT=0x0A00;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
