    "cmake.sourceDirectory": "D:/projects/GameServerFramework/flatbuffer/flatbuffers-1.12.0",
    // 벤더링된 flatbuffers 1.12.0 안드로이드 샘플은 Gradle 4.0 래퍼를 쓴다.
    // Gradle 4.0은 Java 9까지만 지원하므로(Java 17은 Gradle 7.3+ 필요) Gradle 확장이
    // 이걸 임포트하면 "Could not use Gradle version 4.0 and Java version 17" 에러가 난다.
    //
    // nestedProjects를 false로 두면 오히려 안 된다. 확장은 "false이고 워크스페이스 루트에
    // build.gradle이 없으면" 하위 폴더 전체를 스캔하는데, 이 저장소는 C++ 프로젝트라
    // 루트에 gradle 마커가 없어서 그 경로를 탄다. 빈 배열을 주면 스캔 자체를 하지 않는다.
    "gradle.nestedProjects": [],
    "gradle.autoDetect": "off",
    "java.gradle.buildServer.enabled": "off"
}
