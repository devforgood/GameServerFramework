// Example IDL file for our monster's schema.
namespace syncnet;

union GameMessages
{ 
  AddAgent,
  RemoveAgent,
  SetMoveTarget,
  ActorInfo,
  UpdateActorNotify,
  Ping,
  SetRaycast,
  Login,
  UseSkill,
  TreeDebugSync,
  EnterGate,
  TreeDebugRequest,
  Interact,
  QuestAccept,
  QuestComplete,
  QuestAbandon,
  QuestSync,
  PartyInvite,
  PartyInviteReply,
  PartyLeave,
  PartyKick,
  PartyLeaderChange,
  PartySync,
  PartyQuestShare,
  PartyQuestShareReply,
  DialogNode,
  DialogSelect,
} // Optionally add more tables.

enum StatusCode:short
{
  Success = 0,
  Failed,
  NotFound,
  AlreadyExists,
}

struct Vec3 {
  x:float;
  y:float;
  z:float;
}

enum GameObjectType:byte
{
  Character = 0,
  Monster,
  // 월드에 액터로 존재하는 NPC(호위 대상 등). 위치만 가진 정적 NPC 는 여기 오지 않는다 —
  // 그쪽은 npc.json 데이터일 뿐이고 클라가 씬에 직접 배치한다.
  Npc,
}

enum AIState:byte
{
  Patrol = 0,
  Detect,
  Attack,
  Dead,
  Destroyed,
}

struct ActorState {
  state:AIState;
}

struct ActorHealth {
  health:int;
}

table GameMessage {
  msg:GameMessages;
  id:int = 0;
  result:StatusCode = Success;
}

table AddAgent {
  gameObjectType:GameObjectType = Monster;
  pos:Vec3;
  actorId:int = 0;
}

table RemoveAgent {
  actorId:int;
}

table SetMoveTarget {
  actorId:int;
  pos:Vec3;
}

table ActorInfo {
  actorId:int;
  pos:Vec3;
  gameObjectType:GameObjectType = Monster;
  state:ActorState;
  health:ActorHealth;
  inputLocked:bool = false;
}

table DebugRaycast {
  startPos:Vec3;
  endPos:Vec3;
}

table UpdateActorNotify {
  actors:[ActorInfo];
  debugs:[DebugRaycast];
  // 관심영역(AoI) 밖으로 나가 더 이상 동기화하지 않는 액터들의 actorId.
  // 사망이 아니라 '시야에서 사라짐'이므로 클라는 사망 연출 없이 조용히 제거한다.
  // (테이블 끝에 추가한 필드라 이전 버전과 호환된다)
  removed:[int];
}

table Ping {
  seq:int;
}

table SetRaycast {
  actorId:int;
  pos:Vec3;
}

table Login {
  userId:string;
  password:string;
  mapId:int = 0;
  pos:Vec3;
  // 재접속 핸드오버: 0 이면 신규 로그인, 0 이 아니면 서버가 유지하던 기존 캐릭터의
  // actor id(재접속). 클라는 이 값이 있으면 AddAgent 를 생략하고 이 id 를 채택한다.
  actorId:int = 0;
  // 재접속 토큰. 서버가 최초 로그인 응답에 플레이어 uuid 를 실어 보내면 클라가 저장했다가
  // 재접속 요청 시 되돌려 보낸다. 서버는 이 값으로 유예 대기 중인 기존 플레이어를 식별한다.
  uuid:string;
}

table UseSkill {
  id:int;
  skillId:int;
  targetId:int;
  pos:Vec3;
  dir:Vec3;
  timestamp:long;
  duration:long;
}

enum TreeNodeStatus:byte
{
  Idle = 0,
  Running,
  Success,
  Failure,
  Skipped,
  Unknown,
}

enum TreeNodeType:byte
{
  Control = 0,
  Condition,
  Action,
}

table TreeDebugNodeDefinition {
  nodeId:ushort;
  parentNodeId:int = -1;
  name:string;
  nodeType:TreeNodeType = Action;
}

table TreeDebugNodeChange {
  nodeId:ushort;
  name:string;
  status:TreeNodeStatus = Idle;
  reason:string;
  successCount:uint;
  failureCount:uint;
  runningCount:uint;
}

table TreeDebugDefinition {
  treeId:string;
  monsterId:long;
  nodes:[TreeDebugNodeDefinition];
}

table TreeDebugRuntimeFrame {
  treeId:string;
  monsterId:long;
  tick:ulong;
  aiState:AIState = Patrol;
  targetActorId:long = -1;
  executedPath:[ushort];
  changes:[TreeDebugNodeChange];
}

table TreeDebugSync {
  definitions:[TreeDebugDefinition];
  frames:[TreeDebugRuntimeFrame];
}

// 클라이언트가 특정 몬스터의 BT 정의(+현재 상태 스냅샷)를 요청한다.
// 몬스터는 플레이어 접속 전에 스폰되어 정의 브로드캐스트를 받지 못하므로,
// 디버그 뷰에서 몬스터를 선택할 때 이 메시지로 정의를 다시 받아온다.
table TreeDebugRequest {
  monsterId:long = -1;
}

table EnterGate {
  mapId:int;
  gateId:int;
  pos:Vec3;
  actorId:int = 0;
}

// NPC 또는 맵 오브젝트와의 상호작용 요청.
// targetId 는 npc.json 의 NPC id 이거나 Map.json 오브젝트 id 다(id 공간이 겹치지 않는다).
// 서버가 같은 맵인지와 거리를 검증하고, 통과하면 퀘스트 목표(talk/interact)가 진행된다.
table Interact {
  targetId:int;
}

table QuestAccept {
  questId:int;
}

table QuestComplete {
  questId:int;
  // 선택 보상의 0-based 인덱스. 선택 보상이 없는 퀘스트는 -1.
  rewardChoice:int = -1;
}

table QuestAbandon {
  questId:int;
}

// 진행 중인 퀘스트 한 건의 상태. progress 는 현재 스테이지의 목표 순서대로다.
table QuestInfo {
  questId:int;
  state:byte = 0;   // 0 InProgress, 1 ReadyToComplete, 2 Failed, 3 Cooldown
  stage:int = 0;
  progress:[int];
}

// 서버 -> 클라 퀘스트 동기화. 바뀐 것만 실어 보낸다(로그인 직후에는 전체).
table QuestSync {
  quests:[QuestInfo];  // 새로 생겼거나 상태가 바뀐 퀘스트
  removed:[int];       // 진행 목록에서 사라진 퀘스트 id(완료/포기/쿨타임)
  completed:[int];     // 이번에 완료 처리된 퀘스트 id (완료 연출용)
}

// ── 파티 ──
// 파티는 접속 중에만 존재하는 상태라 DB 에 남지 않는다. 클라는 PartySync 만 믿으면 된다.

// 초대. 클라 -> 서버는 actorId(화면에서 고른 캐릭터)만 채우고, 서버 -> 클라 알림은
// 나머지를 채운다. 이름이 아니라 actorId 로 부르는 이유는 이름이 유일하다는 보장이
// 없기 때문이다 — 화면에서 고른 그 캐릭터가 그대로 대상이 된다.
table PartyInvite {
  actorId:int;          // C->S: 초대할 캐릭터의 actor id
  partyId:int = 0;      // S->C: 초대한 쪽의 파티 id(0 이면 수락 시 새로 만들어진다)
  inviterId:long = 0;   // S->C: 초대한 플레이어 id
  inviterName:string;   // S->C
  timeoutSec:float = 0; // S->C: 남은 응답 시간. 클라는 이 시간에 맞춰 창을 닫는다
}

table PartyInviteReply {
  accept:bool = false;
}

table PartyLeave {
}

table PartyKick {
  playerId:long;
}

table PartyLeaderChange {
  playerId:long;
}

table PartyMemberInfo {
  playerId:long;
  name:string;
  level:int = 1;
  // 이 멤버의 캐릭터 actor id 와 맵. 다른 맵에 있으면 actorId 는 0 이다
  // (같은 맵이 아니면 클라에 그 액터가 존재하지 않는다).
  actorId:int = 0;
  mapId:int = 0;
}

// 서버 -> 클라 파티 로스터. partyId 가 0 이면 파티에 속해 있지 않다는 뜻이고,
// 이때 members 는 비어 있다(탈퇴/추방/해산이 모두 이 형태로 전달된다).
table PartySync {
  partyId:int = 0;
  leaderId:long = 0;
  members:[PartyMemberInfo];
}

// 퀘스트 공유. C->S 는 questId 만, S->C 알림은 보낸 사람과 남은 시간을 채운다.
// 공유 요청에 대한 '응답'에서는 fromPlayerId 에 제안이 실제로 간 인원 수가 담긴다
// (알림과 응답은 GameMessage.id 로 구분된다 — 응답은 요청의 id 를, 알림은 0 을 쓴다).
table PartyQuestShare {
  questId:int;
  fromPlayerId:long = 0;
  fromName:string;
  timeoutSec:float = 0;
}

table PartyQuestShareReply {
  questId:int;
  accept:bool = false;
}

// ── 대화 ──
// 대화 상태는 서버가 들고 있다. 클라는 받은 노드를 그리고, 고른 번호를 되돌려 보낸다.
// 대화는 Interact 로 열린다(따로 여는 메시지가 없다) — NPC 를 누르는 동작 하나로 족하다.

table DialogChoiceInfo {
  textId:string;
  // 이 선택지가 무엇을 하는지("close" / "goto" / "accept_quest" / "complete_quest").
  // 클라가 아이콘을 고르는 데만 쓴다 — 실제 처리는 서버가 한다.
  action:string;
}

// 서버 -> 클라. nodeId 가 0 이면 대화가 끝났다는 뜻이고 나머지 필드는 비어 있다.
table DialogNode {
  nodeId:int = 0;
  npcId:int = 0;
  textId:string;
  choices:[DialogChoiceInfo];
}

// 클라 -> 서버. nodeId 는 클라가 보고 있던 노드다 — 서버가 아는 것과 다르면 거절한다
// (창을 두 번 누르면 지난 화면의 선택지로 지금 노드의 동작이 실행된다).
// choiceIndex 가 음수면 "대화 닫기"다.
table DialogSelect {
  nodeId:int = 0;
  choiceIndex:int = -1;
}

root_type GameMessage;
