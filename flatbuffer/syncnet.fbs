// Example IDL file for our monster's schema.
namespace syncnet;

union GameMessages
{ 
  AddAgent,
  RemoveAgent,
  SetMoveTarget,
  ActorInfo,
  UpdateActorNotify,
  Ping,
  SetRaycast,
  Login,
  UseSkill,
  TreeDebugSync,
  EnterGate,
  TreeDebugRequest,
} // Optionally add more tables.

enum StatusCode:short
{
  Success = 0,
  Failed,
  NotFound,
  AlreadyExists,
}

struct Vec3 {
  x:float;
  y:float;
  z:float;
}

enum GameObjectType:byte 
{ 
  Character = 0, 
  Monster 
}

enum AIState:byte
{
  Patrol = 0,
  Detect,
  Attack,
  Dead,
  Destroyed,
}

struct ActorState {
  state:AIState;
}

struct ActorHealth {
  health:int;
}

table GameMessage {
  msg:GameMessages;
  id:int = 0;
  result:StatusCode = Success;
}

table AddAgent {
  gameObjectType:GameObjectType = Monster;
  pos:Vec3;
  agentId:int = 0;
}

table RemoveAgent {
  agentId:int;
}

table SetMoveTarget {
  agentId:int;
  pos:Vec3;
}

table ActorInfo {
  agentId:int;
  pos:Vec3;
  gameObjectType:GameObjectType = Monster;
  state:ActorState;
  health:ActorHealth;
  inputLocked:bool = false;
}

table DebugRaycast {
  startPos:Vec3;
  endPos:Vec3;
}

table UpdateActorNotify {
  actors:[ActorInfo];
  debugs:[DebugRaycast];
}

table Ping {
  seq:int;
}

table SetRaycast {
  agentId:int;
  pos:Vec3;
}

table Login {
  userId:string;
  password:string;
  mapId:int = 0;
  pos:Vec3;
  // 재접속 핸드오버: 0 이면 신규 로그인, 0 이 아니면 서버가 유지하던 기존 캐릭터의
  // agent id(재접속). 클라는 이 값이 있으면 AddAgent 를 생략하고 이 id 를 채택한다.
  agentId:int = 0;
  // 재접속 토큰. 서버가 최초 로그인 응답에 플레이어 uuid 를 실어 보내면 클라가 저장했다가
  // 재접속 요청 시 되돌려 보낸다. 서버는 이 값으로 유예 대기 중인 기존 플레이어를 식별한다.
  uuid:string;
}

table UseSkill {
  id:int;
  skillId:int;
  targetId:int;
  pos:Vec3;
  dir:Vec3;
  timestamp:long;
  duration:long;
}

enum TreeNodeStatus:byte
{
  Idle = 0,
  Running,
  Success,
  Failure,
  Skipped,
  Unknown,
}

enum TreeNodeType:byte
{
  Control = 0,
  Condition,
  Action,
}

table TreeDebugNodeDefinition {
  nodeId:ushort;
  parentNodeId:int = -1;
  name:string;
  nodeType:TreeNodeType = Action;
}

table TreeDebugNodeChange {
  nodeId:ushort;
  name:string;
  status:TreeNodeStatus = Idle;
  reason:string;
  successCount:uint;
  failureCount:uint;
  runningCount:uint;
}

table TreeDebugDefinition {
  treeId:string;
  monsterId:long;
  nodes:[TreeDebugNodeDefinition];
}

table TreeDebugRuntimeFrame {
  treeId:string;
  monsterId:long;
  tick:ulong;
  aiState:AIState = Patrol;
  targetAgentId:long = -1;
  executedPath:[ushort];
  changes:[TreeDebugNodeChange];
}

table TreeDebugSync {
  definitions:[TreeDebugDefinition];
  frames:[TreeDebugRuntimeFrame];
}

// 클라이언트가 특정 몬스터의 BT 정의(+현재 상태 스냅샷)를 요청한다.
// 몬스터는 플레이어 접속 전에 스폰되어 정의 브로드캐스트를 받지 못하므로,
// 디버그 뷰에서 몬스터를 선택할 때 이 메시지로 정의를 다시 받아온다.
table TreeDebugRequest {
  monsterId:long = -1;
}

table EnterGate {
  mapId:int;
  gateId:int;
  pos:Vec3;
  agentId:int = 0;
}

root_type GameMessage;
