{
  "_comment": [
    "봇 부하 테스트 실행 설정. Bot.exe 는 실행 디렉터리의 bot_config.json 을 읽는다.",
    "이 파일을 bot_config.json 으로 복사해 값을 맞춘 뒤 실행할 것.",
    "커맨드라인 인자(--bots, --threads 등)가 이 파일보다 우선한다."
  ],

  "server": {
    "host": "127.0.0.1",
    "port": 65001
  },

  "bots": {
    "_comment": [
      "봇마다 계정 id 가 달라야 한다. 같은 id 로 두 세션이 붙으면 서버가",
      "먼저 붙은 쪽을 쫓아낸다(EvictExistingLogin)."
    ],
    "count": 50,
    "user_prefix": "bot_",
    "user_index_start": 1,
    "auth_token": ""
  },

  "run": {
    "worker_threads": 4,
    "connects_per_second": 20,
    "duration_seconds": 60,
    "tick_ms": 100,
    "report_interval_seconds": 5,
    "reconnect": true,
    "reconnect_delay_ms": 2000
  },

  "ai": {
    "_comment": "attack_range 는 skill.json 의 스킬 사거리(기본 공격 2)보다 조금 짧게 잡는다.",
    "search_radius": 30.0,
    "attack_range": 1.6,
    "attack_skill_id": 1,
    "attack_interval_ms": 600,
    "move_repath_ms": 500,
    "wander_radius": 15.0,
    "wander_interval_ms": 4000,
    "arrive_epsilon": 1.0,
    "ping_interval_ms": 1000
  },

  "limits": {
    "_comment": "서버 server_config.json 의 network.max_packets_per_second 보다 낮게 유지할 것.",
    "max_packets_per_second": 20,
    "packet_burst": 40
  },

  "log": {
    "level": "info",
    "verbose_bots": 2,
    "csv_path": ""
  }
}
